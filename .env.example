# MoreLinks - Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# OPENROUTER API (Obbligatorio per Omni Brain)
# ==========================================
# Ottieni la chiave gratuita su: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ==========================================
# GITHUB (Opzionale - per sync memoria cloud)
# ==========================================
# Genera su: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# ==========================================
# DATABASE (Opzionale)
# ==========================================
# Percorso database (default: ./morelinks.db)
# DB_PATH=/path/to/morelinks.db

# ==========================================
# APP CONFIGURATION
# ==========================================
# Modalità debug (True/False)
DEBUG=True

# Lingua predefinita
LANGUAGE=it

# Nome app
APP_NAME=MoreLinks
APP_VERSION=1.0.0
